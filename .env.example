BIND_HOST="0.0.0.0"
PORT="3001"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# MariaDB chứa dump legacy. Production dùng user chỉ có SELECT users/note_links
# và UPDATE ba cột nội dung của note_links; không cấp INSERT/DELETE.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="legacy_stu"
MYSQL_USER="stu_note_editor"
MYSQL_PASSWORD=""
MYSQL_CONNECTION_LIMIT="5"
# disabled cho dokploy-network nội bộ; required khi MySQL endpoint hỗ trợ TLS.
MYSQL_SSL_MODE="disabled"
